# Copy to .env.local for local development, and set the same values in your
# host's environment variables panel (Vercel: Settings → Environment Variables).
# .env.local is git-ignored — never commit real credentials.

# Public site URL, used for canonical tags, Open Graph and the sitemap.
# Falls back to the value in src/content/site.ts when unset.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Where enquiry notifications should be delivered. Read only on the server.
QUOTE_NOTIFICATION_EMAIL=""

# API key for the email provider that sends enquiries (Resend, SendGrid, SES…).
# Consumed in src/app/api/quote/route.ts. Server-side only — do not prefix with
# NEXT_PUBLIC_, which would expose it in the browser bundle.
EMAIL_PROVIDER_API_KEY=""
